create_clock -period 20.0 -name clk_50mhz [get_ports clk_50mhz]
create_clock -period 100.0 -name clk_10mhz [get_ports clk_10mhz]

create_generated_clock -name clk_1mhz \
    -source [get_ports clk_10mhz] \
    -divide_by 10 \
    [get_pins {pll_inst|c0}]

set_clock_groups -asynchronous \
    -group {clk_1mhz} \
    -group {clk_50mhz}
	 
set_false_path -from [get_ports reset_n]

